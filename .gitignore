
# -----------------------------------------------------------------------------
# Laravel .gitignore
# -----------------------------------------------------------------------------

# === 1. CRITICAL: Secrets & Environment Files ===
# This is the most important section.
# This line would have prevented your account from being hacked.
.env
.env.*
!.env.example

# === 2. Laravel Dependencies ===
# These are managed by Composer and NPM and should not be tracked.
/vendor/
/node_modules/

# === 3. Laravel Cache, Storage, & Logs ===
# These files are generated by the application and should not be in Git.
/bootstrap/cache/*.php
/storage/app/
/storage/app/public/
/storage/framework/
/storage/logs/
/storage/*.key

# === 4. Laravel Public Assets ===
# These are built from your source files or are symlinks.
/public/hot
/public/storage

# === 5. Testing & Local Development ===
.phpunit.result.cache
Homestead.yaml
Homestead.json
.vagrant/

# === 6. OS & IDE Files (General) ===
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/

.vercel
.env*
